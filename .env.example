# Supabase Edge Function secrets — set these in the Supabase dashboard
# (Project Settings → Edge Functions → Secrets), not in this file.

# Bunny Stream HLS hostname (your Pull Zone CDN host, no scheme, no trailing slash)
# Example: vz-12345abc-xyz.b-cdn.net
BUNNY_HLS_HOSTNAME=

# Bunny Stream Token Authentication Key
# Found in: Bunny dashboard → Stream → your library → Security → Token Authentication Key
BUNNY_TOKEN_AUTH_KEY=
