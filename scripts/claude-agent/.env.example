# Claude Code laptop helper — config. Copy this file to ".env" (same folder) and fill in the secret.
# The .env file is gitignored — never commit the real secret.

# REQUIRED — the shared secret. Must be IDENTICAL to the CLAUDE_AGENT_SECRET set in the Supabase
# edge-function secrets (Dashboard → Project → Edge Functions → Secrets, or `supabase secrets set`).
CLAUDE_AGENT_SECRET=

# Optional overrides (defaults are usually fine):
# CLAUDE_AGENT_REPO=C:\Users\akmal\Documents\GitHub\ai-creator-studio-new
# CLAUDE_BIN=claude
# CLAUDE_MAX_TURNS=40
# CLAUDE_TASK_TIMEOUT_MIN=25
# CLAUDE_POLL_SEC=15
# CLAUDE_AGENT_URL=https://cdyidatkegxwhtuoqxly.supabase.co/functions/v1/claude-agent
